{
  "name": "Patient Intake - Alex",
  "firstMessage": "Hi, thanks for calling Riverside Family Clinic, this is Alex. I can get you registered as a new patient. Could I start with your first and last name?",
  "model": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "temperature": 0.3,
    "maxTokens": 250,
    "messages": [{ "role": "system", "content": "__SYSTEM_PROMPT__" }],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "lookup_patient",
          "description": "Check whether a patient already exists for a phone number. With no phone_number it uses the caller ID.",
          "parameters": {
            "type": "object",
            "properties": {
              "phone_number": { "type": "string", "description": "Phone number the caller gave, any format. Omit to use caller ID." }
            }
          }
        },
        "server": { "url": "__BASE_URL__/vapi/tools", "headers": { "X-Vapi-Secret": "__WEBHOOK_SECRET__" } }
      },
      {
        "type": "function",
        "function": {
          "name": "validate_field",
          "description": "Validate and normalise one detail right after the caller says it. Returns valid, normalized, say_back, or an error to read to the caller.",
          "parameters": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "enum": ["first_name", "last_name", "date_of_birth", "sex", "phone_number", "email", "address_line_1", "address_line_2", "city", "state", "zip_code", "insurance_provider", "insurance_member_id", "preferred_language", "emergency_contact_name", "emergency_contact_phone"]
              },
              "value": { "type": "string", "description": "The value as the caller gave it. Dates as MM/DD/YYYY." }
            },
            "required": ["field", "value"]
          }
        },
        "server": { "url": "__BASE_URL__/vapi/tools", "headers": { "X-Vapi-Secret": "__WEBHOOK_SECRET__" } }
      },
      {
        "type": "function",
        "function": {
          "name": "save_patient",
          "description": "Create the patient record. Only call after the caller has confirmed every detail is correct.",
          "parameters": {
            "type": "object",
            "properties": {
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": { "type": "string", "description": "MM/DD/YYYY" },
              "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
              "phone_number": { "type": "string", "description": "10 digits" },
              "email": { "type": "string" },
              "address_line_1": { "type": "string", "description": "Street number and name" },
              "address_line_2": { "type": "string", "description": "Apt, suite or unit" },
              "city": { "type": "string" },
              "state": { "type": "string", "description": "2-letter code, e.g. TX" },
              "zip_code": { "type": "string" },
              "insurance_provider": { "type": "string" },
              "insurance_member_id": { "type": "string" },
              "preferred_language": { "type": "string" },
              "emergency_contact_name": { "type": "string" },
              "emergency_contact_phone": { "type": "string" }
            },
            "required": ["first_name", "last_name", "date_of_birth", "sex", "phone_number", "address_line_1", "city", "state", "zip_code"]
          }
        },
        "server": { "url": "__BASE_URL__/vapi/tools", "headers": { "X-Vapi-Secret": "__WEBHOOK_SECRET__" } },
        "messages": [{ "type": "request-start", "content": "Great, let me save that for you." }]
      },
      {
        "type": "function",
        "function": {
          "name": "update_patient",
          "description": "Update an existing patient found by lookup_patient. Send patient_id plus only the fields that changed, after the caller confirms them.",
          "parameters": {
            "type": "object",
            "properties": {
              "patient_id": { "type": "string" },
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": { "type": "string", "description": "MM/DD/YYYY" },
              "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
              "phone_number": { "type": "string" },
              "email": { "type": "string" },
              "address_line_1": { "type": "string" },
              "address_line_2": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string" },
              "zip_code": { "type": "string" },
              "insurance_provider": { "type": "string" },
              "insurance_member_id": { "type": "string" },
              "preferred_language": { "type": "string" },
              "emergency_contact_name": { "type": "string" },
              "emergency_contact_phone": { "type": "string" }
            },
            "required": ["patient_id"]
          }
        },
        "server": { "url": "__BASE_URL__/vapi/tools", "headers": { "X-Vapi-Secret": "__WEBHOOK_SECRET__" } },
        "messages": [{ "type": "request-start", "content": "One moment while I update that." }]
      },
      { "type": "endCall" }
    ]
  },
  "voice": { "provider": "vapi", "voiceId": "Elliot" },
  "transcriber": { "provider": "deepgram", "model": "nova-3", "language": "multi" },
  "server": { "url": "__BASE_URL__/vapi/events", "headers": { "X-Vapi-Secret": "__WEBHOOK_SECRET__" } },
  "serverMessages": ["end-of-call-report"],
  "silenceTimeoutSeconds": 30,
  "maxDurationSeconds": 900
}