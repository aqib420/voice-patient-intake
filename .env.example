# Postgres connection. Railway injects DATABASE_URL automatically when you
# reference its Postgres service; locally use docker-compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patients

# Shared secret Vapi sends in the X-Vapi-Secret header on every webhook.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_WEBHOOK_SECRET=change-me

# Insert two demo patients on first boot if the table is empty.
SEED_DATA=true

LOG_LEVEL=INFO
